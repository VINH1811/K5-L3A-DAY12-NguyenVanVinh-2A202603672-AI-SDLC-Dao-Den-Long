{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Đảo Đèn Lồng — game 3D góc nhìn thứ ba (Three.js) với lõi mô phỏng tất định chạy headless bằng Node.",
  "scripts": {
    "start": "node tools/start.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "headless": "node tools/headless.mjs",
    "bench": "node tools/bench.mjs --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc --single-threaded --max-semi-space-size=1 tools/soak.mjs --seed 7 --nights 10 --out soak.json",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^5.4.11"
  }
}
